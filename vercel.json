{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo без зависимостей",
  "buildCommand": "echo статика, сборка не нужна",
  "outputDirectory": "vendor-site",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/politika.html",
      "permanent": false
    },
    {
      "source": "/policy",
      "destination": "/politika.html",
      "permanent": false
    },
    {
      "source": "/politika",
      "destination": "/politika.html",
      "permanent": false
    },
    {
      "source": "/oferta",
      "destination": "/oferta.html",
      "permanent": false
    },
    {
      "source": "/offer",
      "destination": "/oferta.html",
      "permanent": false
    },
    {
      "source": "/vozvrat",
      "destination": "/vozvrat.html",
      "permanent": false
    }
  ]
}
