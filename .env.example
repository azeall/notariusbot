# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

DATABASE_URL=postgresql+asyncpg://notary:пароль@127.0.0.1:5432/notarybot

# Публичный адрес сервиса — из него собираются одноразовые ссылки на загрузку.
PUBLIC_BASE_URL=https://example.ru

# Ключ шифрования документов. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_ENCRYPTION_KEY=

# Ключ подписи сессионных куки сотрудников. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Вход владельца сервиса (кабинет /platform). Пароль пустой — при первом
# запуске app.seed придумает случайный и напечатает его один раз.
PLATFORM_ADMIN_EMAIL=admin@example.ru
PLATFORM_ADMIN_PASSWORD=

# Сколько заявок принимаем с одного адреса в час.
REQUESTS_PER_IP_PER_HOUR=5

# Через сколько дней после закрытия заявки стираются документы.
# Здесь стояло 90 — старое значение, снижённое в коде до 14 сознательно:
# наше хранилище это перевозка, а не архив. Пример пережил то решение
# и молча возвращал 90 дней хранения паспортов каждому, кто копировал файл.
DOCUMENT_RETENTION_DAYS=14

# Предельный возраст файла с момента загрузки — срабатывает независимо
# от того, закрыли заявку или забыли.
DOCUMENT_MAX_AGE_DAYS=90

# --- каналы ---

# Токен бота от @BotFather. Пустой — Telegram-бот просто не запускается.
TELEGRAM_BOT_TOKEN=

# Токен бота MAX. Пустой — адаптер не запускается.
MAX_BOT_TOKEN=

# К какому нотариусу попадает клиент, пришедший в бот без deep-link.
DEFAULT_TENANT_SLUG=demo
